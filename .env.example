# --- WhatsApp Cloud API (via BSP: Twilio / 360dialog, or Meta direct) ---
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
VERIFY_TOKEN=change-me-long-random-string

# --- LLM (OpenAI-compatible; point OPENAI_BASE_URL at OpenRouter/etc. if preferred) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHEAP_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o
CONFIDENCE_THRESHOLD=0.6
# LLM_PROVIDER: auto | mock | openai   (auto = mock when no OPENAI_API_KEY)
LLM_PROVIDER=auto

# --- App ---
DATABASE_URL=sqlite:///./synappse.db
ADMIN_TOKEN=change-me-admin
